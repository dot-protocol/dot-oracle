<?xml version="1.0" encoding="UTF-8"?>
<!-- oracle-core ask_for_seat: an open ask as one named seat's inbox shows it: which list, or none (generated by lifecycle::scxml; tests/lifecycle.rs checks the code against it) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="ask_for_seat" initial="waiting">
  <state id="waiting">
    <transition event="mark.ack" target="acked"/> <!-- ack or go -->
    <transition event="mark.stuck" target="stuck"/>
    <transition event="mark.later" target="later"/> <!-- until a time still to come -->
    <transition event="mark.done" target="off"/> <!-- done or no -->
    <transition event="deliver.seat" target="off"/>
    <transition event="close.asker" target="off"/>
  </state>
  <state id="acked">
    <transition event="mark.stuck" target="stuck"/>
    <transition event="mark.later" target="later"/> <!-- until a time still to come -->
    <transition event="mark.seen" target="waiting"/>
    <transition event="mark.later_past" target="waiting"/> <!-- its time has passed -->
    <transition event="mark.done" target="off"/> <!-- done or no -->
    <transition event="deliver.seat" target="off"/>
    <transition event="close.asker" target="off"/>
  </state>
  <state id="stuck">
    <transition event="mark.ack" target="acked"/> <!-- ack or go -->
    <transition event="mark.later" target="later"/> <!-- until a time still to come -->
    <transition event="mark.seen" target="waiting"/>
    <transition event="mark.later_past" target="waiting"/> <!-- its time has passed -->
    <transition event="mark.done" target="off"/> <!-- done or no -->
    <transition event="deliver.seat" target="off"/>
    <transition event="close.asker" target="off"/>
  </state>
  <state id="later">
    <transition event="mark.ack" target="acked"/> <!-- ack or go -->
    <transition event="mark.stuck" target="stuck"/>
    <transition event="mark.seen" target="waiting"/>
    <transition event="mark.later_past" target="waiting"/> <!-- its time has passed -->
    <transition event="mark.done" target="off"/> <!-- done or no -->
    <transition event="deliver.seat" target="off"/>
    <transition event="close.asker" target="off"/>
  </state>
  <state id="off">
    <transition event="mark.ack" target="acked"/> <!-- the ask is still open for this seat -->
    <transition event="mark.stuck" target="stuck"/> <!-- the ask is still open for this seat -->
    <transition event="mark.later" target="later"/> <!-- the ask is still open for this seat -->
    <transition event="mark.seen" target="waiting"/> <!-- the ask is still open for this seat -->
    <transition event="mark.later_past" target="waiting"/> <!-- the ask is still open for this seat -->
  </state>
</scxml>
