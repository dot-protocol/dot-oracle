<?xml version="1.0" encoding="UTF-8"?>
<!-- oracle-core obligation: one holder's part of an addressed act, review or decide ask on a subject (generated by lifecycle::scxml; tests/lifecycle.rs checks the code against it) -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" name="obligation" initial="open">
  <state id="open">
    <transition event="commit.holder" target="owned"/> <!-- the holder says it takes it (intent:commit) -->
    <transition event="result.holder" target="answered"/> <!-- the holder's result or receipt -->
    <transition event="verdict.approve.holder" target="done"/> <!-- review; on the current revision -->
    <transition event="verdict.changes.holder" target="changes"/> <!-- review; on the current revision -->
    <transition event="close.asker" target="done"/>
    <transition event="close.decider" target="done"/>
    <transition event="cancel.asker" target="cancelled"/>
    <transition event="cancel.decider" target="cancelled"/>
  </state>
  <state id="owned">
    <transition event="result.holder" target="answered"/> <!-- the holder's result or receipt -->
    <transition event="verdict.approve.holder" target="done"/> <!-- review; on the current revision -->
    <transition event="verdict.changes.holder" target="changes"/> <!-- review; on the current revision -->
    <transition event="close.asker" target="done"/>
    <transition event="close.decider" target="done"/>
    <transition event="cancel.asker" target="cancelled"/>
    <transition event="cancel.decider" target="cancelled"/>
  </state>
  <state id="answered">
    <transition event="verdict.approve.holder" target="done"/> <!-- review; on the current revision -->
    <transition event="verdict.changes.holder" target="changes"/> <!-- review; on the current revision -->
    <transition event="close.asker" target="done"/>
    <transition event="close.decider" target="done"/>
    <transition event="cancel.asker" target="cancelled"/>
    <transition event="cancel.decider" target="cancelled"/>
  </state>
  <state id="changes">
    <transition event="verdict.approve.holder" target="done"/> <!-- review; on the current revision -->
    <transition event="revision.implementer" target="open"/> <!-- review; the holder had not committed or answered -->
    <transition event="revision.implementer" target="owned"/> <!-- review; the holder had committed -->
    <transition event="revision.implementer" target="answered"/> <!-- review; the holder had answered -->
    <transition event="close.asker" target="done"/>
    <transition event="close.decider" target="done"/>
    <transition event="cancel.asker" target="cancelled"/>
    <transition event="cancel.decider" target="cancelled"/>
  </state>
  <state id="done">
    <transition event="verdict.changes.holder" target="changes"/> <!-- review; the newest verdict wins -->
    <transition event="revision.implementer" target="open"/> <!-- review; the holder had not committed or answered -->
    <transition event="revision.implementer" target="owned"/> <!-- review; the holder had committed -->
    <transition event="revision.implementer" target="answered"/> <!-- review; the holder had answered -->
    <transition event="cancel.asker" target="cancelled"/>
    <transition event="cancel.decider" target="cancelled"/>
  </state>
  <state id="cancelled">
    <transition event="close.asker" target="done"/>
    <transition event="close.decider" target="done"/>
  </state>
</scxml>
